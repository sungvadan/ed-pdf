<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:PdfSvd"
        x:Class="PdfSvd.MainWindow"
        Title="pdf-svd" Width="1100" Height="800" MinWidth="760" MinHeight="400"
        Icon="/Assets/pdf-svd.ico"
        DragDrop.AllowDrop="True">
    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Name="FileMenu">
                <MenuItem Name="OpenItem" />
                <MenuItem Name="SaveItem" />
                <MenuItem Name="SaveAsItem" />
                <Separator />
                <MenuItem Name="SendExportItem" />
                <MenuItem Name="ImageExportItem" />
                <MenuItem Name="ReduceSizeItem" />
                <Separator />
                <MenuItem Name="PrintItem" />
                <Separator Name="DefaultAppSeparator" />
                <MenuItem Name="DefaultAppItem" />
                <Separator />
                <MenuItem Name="QuitItem" />
            </MenuItem>
            <MenuItem Name="EditMenu">
                <MenuItem Name="UndoItem" />
                <MenuItem Name="RedoItem" />
                <Separator />
                <MenuItem Name="CopyItem" />
                <MenuItem Name="DeleteItem" />
                <MenuItem Name="SelectAllItem" />
                <Separator />
                <MenuItem Name="FindItem" />
                <MenuItem Name="FindNextItem" />
                <MenuItem Name="FindPreviousItem" />
            </MenuItem>
            <!-- Filled in MainWindow.Pages.cs (same items as the thumbnails' context menu). -->
            <MenuItem Name="PagesMenu" />
        </Menu>

        <Border DockPanel.Dock="Top" Padding="8,6" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Name="OpenButton" />
                    <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <Button Name="PreviousButton" Classes="tool" Content="‹" FontSize="18" Padding="6,0,6,3" />
                    <TextBox Name="PageBox" Width="52" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Name="PageCountText" VerticalAlignment="Center" MinWidth="40" />
                    <Button Name="NextButton" Classes="tool" Content="›" FontSize="18" Padding="6,0,6,3" />
                    <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <Button Name="RotateLeftButton" Classes="tool" />
                    <Button Name="RotateRightButton" Classes="tool" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Name="ZoomOutButton" Classes="tool" Content="−" FontSize="16" />
                    <TextBlock Name="ZoomText" VerticalAlignment="Center" MinWidth="48" TextAlignment="Center" />
                    <Button Name="ZoomInButton" Classes="tool" Content="+" FontSize="16" />
                    <Button Name="FitButton" />
                    <Rectangle Width="1" Height="20" Margin="6,0" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                    <TextBox Name="SearchBox" Width="190" VerticalAlignment="Center" />
                    <TextBlock Name="MatchText" VerticalAlignment="Center" MinWidth="44" TextAlignment="Center" Opacity="0.7" />
                    <Button Name="PreviousMatchButton" Classes="tool" Content="˄" />
                    <Button Name="NextMatchButton" Classes="tool" Content="˅" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Annotation tools and properties (filled in MainWindow.Annotations.cs). -->
        <Border Name="AnnotationBar" DockPanel.Dock="Top" Padding="8,4" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <StackPanel Name="ToolButtons" Orientation="Horizontal" Spacing="2" />
                <Rectangle Width="1" Height="20" Margin="8,0" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <StackPanel Name="ColorButtons" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                <ComboBox Name="LineWidthBox" Margin="8,0,0,0" VerticalAlignment="Center" />
                <ComboBox Name="FontSizeBox" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button Name="DeleteButton" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Button Name="ApplyRedactionButton" Margin="8,0,0,0" VerticalAlignment="Center" Classes="accent" />
                <Rectangle Width="1" Height="20" Margin="8,0" Fill="{DynamicResource SystemControlForegroundBaseLowBrush}" />
                <Button Name="SignButton" VerticalAlignment="Center" />
                <Button Name="StampButton" Margin="4,0,0,0" VerticalAlignment="Center" />
                <Button Name="ImageButton" Margin="4,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Thumbnails: multiple selection, drag to reorder, files dropped are inserted (MainWindow.Pages.cs). -->
        <Panel DockPanel.Dock="Left" Width="168">
            <ListBox Name="Thumbnails" Padding="0,6" SelectionMode="Multiple"
                     Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:PageItem">
                        <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="0,4">
                            <Border Width="{Binding Width}" Height="{Binding Height}" Background="White"
                                    BoxShadow="0 1 3 0 #40000000">
                                <Image Source="{Binding Bitmap}" Stretch="Fill" />
                            </Border>
                            <TextBlock Text="{Binding Number}" HorizontalAlignment="Center" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Canvas IsHitTestVisible="False">
                <Rectangle Name="DropIndicator" Height="3" Width="140" Canvas.Left="14" RadiusX="1.5" RadiusY="1.5"
                           Fill="{DynamicResource SystemControlHighlightAccentBrush}" IsVisible="False" />
            </Canvas>
        </Panel>

        <Panel Background="{DynamicResource SystemControlBackgroundBaseLowBrush}">
            <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="True">
                <ItemsControl Name="Pages" HorizontalAlignment="Center" Margin="20,8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:PageItem">
                            <Border Width="{Binding Width}" Height="{Binding Height}" Margin="0,8" Background="White"
                                    BoxShadow="0 2 6 0 #40000000">
                                <local:PageView />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <!-- In-place editor of text boxes, placed over the page. -->
            <Canvas Name="EditorLayer" ClipToBounds="True">
                <TextBox Name="Editor" IsVisible="False" AcceptsReturn="True" TextWrapping="Wrap"
                         Background="Transparent" BorderThickness="1" MinHeight="0" MinWidth="0" />
                <!-- In-place editor of a paragraph of the page (MainWindow.TextEditing.cs). -->
                <TextBox Name="ParagraphEditor" IsVisible="False" AcceptsReturn="True" Padding="0"
                         BorderThickness="1" MinHeight="0" MinWidth="0" />
            </Canvas>
            <TextBlock Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" FontSize="15" TextAlignment="Center" />
        </Panel>
    </DockPanel>
</Window>
