<Project Sdk="Microsoft.NET.Sdk">
  <!-- pdf-svd for Windows (Avalonia + PDFium). Built on the Mac by scripts/build-windows.sh; `dotnet run` runs it on the Mac. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>pdf-svd</AssemblyName>
    <RootNamespace>PdfSvd</RootNamespace>
    <ApplicationIcon>Assets/pdf-svd.ico</ApplicationIcon>
    <Product>pdf-svd</Product>
    <Version>0.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
    <!-- Same translations as the Mac app (French source text = key). -->
    <EmbeddedResource Include="../Resources/Localizations/*.lproj/Localizable.strings"
                      LogicalName="l10n/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../Vendor/pdfium-windows/licenses/*" LogicalName="licenses/%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- PDFium: the Windows DLL for the target, or the Mac dylib for `dotnet run` on the Mac. -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('win-'))">
    <None Include="../Vendor/pdfium-windows/$(RuntimeIdentifier)/pdfium.dll" Link="pdfium.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">
    <None Include="../Vendor/pdfium/lib/libpdfium.dylib" Link="libpdfium.dylib" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
